{
  "manifest_version": 3,
  "name": "Vodka-Arena-Model",
  "version": "2.19.9",
  "author": "Vodka",
  "description": "Arena 模型识别工具：支持价格指纹、数字指纹与组合排序，提供会话账单、可选按最接近候选改名、连续抽卡和每日额度查询。",
  "minimum_chrome_version": "118",
  "permissions": [
    "activeTab",
    "storage",
    "webRequest"
  ],
  "optional_permissions": [
    "debugger"
  ],
  "host_permissions": [
    "https://arena.ai/*",
    "https://canary.arena.ai/*",
    "https://api.trigger.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://whatsmyllm.com https://arena.ai https://canary.arena.ai https://api.trigger.dev"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vodka-Arena-Model"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arena.ai/*",
        "https://canary.arena.ai/*"
      ],
      "js": [
        "network-sniffer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://arena.ai/*",
        "https://canary.arena.ai/*"
      ],
      "js": [
        "probe-runtime.js",
        "text-channel.js",
        "conversation-rename.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
